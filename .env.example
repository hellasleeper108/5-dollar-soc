# Sanitized dotenv example for a $5 SOC / Hermes home lab.
# Copy to .env and replace placeholders before use.
# Never commit real keys.

# Hermes / model provider
OPENROUTER_API_KEY=your-openrouter-key

# Messaging / delivery
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_HOME_CHAT_ID=your-chat-id

# Email pipeline (AgentMail)
AGENTMAIL_API_KEY=your-agentmail-key
AGENTMAIL_USER_INBOX=you@agentmail.to
AGENTMAIL_AGENT_INBOX=agent@agentmail.to
FORWARD_TO_EMAIL=you@example.com

# Optional threat intel enrichment
SHODAN_API_KEY=your-shodan-key
ABUSEIPDB_API_KEY=your-abuseipdb-key
VIRUSTOTAL_API_KEY=your-virustotal-key
IPINFO_API_KEY=your-ipinfo-key
OTX_API_KEY=your-otx-key
